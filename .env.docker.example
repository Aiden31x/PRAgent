# Docker Compose environment template.
# Copy this file to .env.docker and fill in your values, then run:
#   docker compose up --build

# --- Database (Neon PostgreSQL) ---
# Get your connection string from https://console.neon.tech
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- GitHub OAuth ---
# Create an OAuth App at https://github.com/settings/developers
# Homepage URL:  http://localhost:3000
# Callback URL:  http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# --- GitHub Personal Access Token (used by MCP server) ---
# Create at https://github.com/settings/tokens
# Scopes: repo, read:org
GITHUB_TOKEN=ghp_your_token_here

# --- LLM Providers ---
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview

# Anthropic Claude — leave blank to disable
ANTHROPIC_API_KEY=
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate-a-random-secret-here

# --- Webhooks ---
WEBHOOK_SECRET=change-me-webhook-secret
# For local dev, use smee.io: https://smee.io/new
WEBHOOK_URL=https://smee.io/your-channel-here

# --- App ---
DEBUG=false
FRONTEND_URL=http://localhost:3000
