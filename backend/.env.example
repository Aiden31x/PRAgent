# --- Database (Neon PostgreSQL) ---
# Get your connection string from https://console.neon.tech
# Make sure to use the asyncpg driver prefix
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- GitHub OAuth ---
# Create an OAuth App at https://github.com/settings/developers
# Homepage URL:  http://localhost:3000
# Callback URL:  http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# --- GitHub Personal Access Token (optional fallback / MCP server) ---
# Create at https://github.com/settings/tokens
# Scopes: repo, read:org
# With OAuth enabled, the agent uses each user's OAuth token instead.
GITHUB_TOKEN=ghp_your_token_here

# --- Google Gemini ---
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Model: gemini-2.5-flash (fast, 15 RPM) or gemini-2.5-pro (smarter, 5 RPM)
GEMINI_MODEL=gemini-2.5-flash

# --- JWT ---
JWT_SECRET=generate-a-random-secret-here

# --- App ---
DEBUG=true
FRONTEND_URL=http://localhost:3000
