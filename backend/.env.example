# --- Database (Neon PostgreSQL) ---
# Get your connection string from https://console.neon.tech
# Make sure to use the asyncpg driver prefix
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- GitHub OAuth ---
# Create an OAuth App at https://github.com/settings/developers
# Homepage URL:  http://localhost:3000
# Callback URL:  http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# --- GitHub Personal Access Token (optional fallback / MCP server) ---
# Create at https://github.com/settings/tokens
# Scopes: repo, read:org
# With OAuth enabled, the agent uses each user's OAuth token instead.
GITHUB_TOKEN=ghp_your_token_here

# --- LLM Providers ---
# Default provider when a user has no preference set ("gemini" or "claude")
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Model: gemini-2.5-flash (fast, 15 RPM) or gemini-2.5-pro (smarter, 5 RPM)
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude — get a key at https://console.anthropic.com/settings/keys
# Leave blank to disable Claude as an option for all users.
ANTHROPIC_API_KEY=
CLAUDE_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# --- JWT ---
JWT_SECRET=generate-a-random-secret-here

# --- Webhooks ---
# Random secret used to verify GitHub webhook signatures.
# Must match what you provide when creating the webhook.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=change-me-webhook-secret
# Public URL that GitHub POSTs to. For local dev, use smee.io:
#   1. Visit https://smee.io and click "Start a new channel"
#   2. Copy the URL and paste it here
#   3. Run: smee -u https://smee.io/YOUR_CHANNEL -t http://localhost:8000/webhooks/github
WEBHOOK_URL=https://smee.io/your-channel-here

# --- App ---
DEBUG=true
FRONTEND_URL=http://localhost:3000
